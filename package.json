{
  "name": "@groton/veracross-directory",
  "version": "0.0.0",
  "private": true,
  "description": "A directory for Veracross configurable by audience and embeddable in the portal",
  "author": {
    "name": "Seth Battis",
    "email": "sbattis@groton.org"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "run-s build:*",
    "build:data": "openapi-typescript \"https://stoplight.io/api/v1/projects/veracross/docs/nodes/reference/Data-API.yaml\" -o ./app/lib/Veracross/Data.ts",
    "build:compile": "next build",
    "deploy": "run-s deploy:*",
    "deploy:build": "run-s build",
    "deploy:deploy": "./scripts/deploy -v",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@battis/lazy-secrets": "^1.0.4",
    "@google-cloud/secret-manager": "^6.1.2",
    "bootstrap": "^5.3.8",
    "next": "16.2.5",
    "openapi-fetch": "^0.17.0",
    "openid-client": "^6.8.4",
    "react": "19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@1password/sdk": "^0.4.0",
    "@battis/descriptive-types": "^0.2.6",
    "@battis/eslint-config": "^2.1.0",
    "@battis/partly-gcloudy": "^3.3.4",
    "@battis/prettier-config": "^1.7.3",
    "@battis/typescript-tricks": "^0.8.2",
    "@commitlint/config-conventional": "^21.0.0",
    "@commitlint/config-pnpm-scopes": "^21.0.0",
    "@inquirer/input": "^5.0.13",
    "@prettier/plugin-xml": "^3.4.2",
    "@qui-cli/core": "^7.0.0",
    "@qui-cli/env": "^5.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.5",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-ejs": "^1.0.3",
    "prettier-plugin-jsdoc": "^1.8.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
